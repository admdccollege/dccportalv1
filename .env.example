# Create a NEW Supabase project for this app. Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domain for sign-in addresses of people with no email. It is never mailed.
ACCOUNT_EMAIL_DOMAIN=accounts.dcc-portal.example
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Protects /api/cron/daily. Use a long random value.
CRON_SECRET=
